<?xml version="1.0" encoding="utf-8"?>
<!-- The "Lock now" launcher shortcut: a dark round badge with a silver padlock. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF17191B" />
            <size android:width="48dp" android:height="48dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_lock_silver" android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp" />
</layer-list>
