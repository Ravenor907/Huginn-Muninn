// Filled in by CMake (configure_file). Windows resources for Huginn.exe. Qt uses IDI_ICON1 as the default window and taskbar icon.
#include <winver.h>

IDI_ICON1 ICON "@HUGINN_RC_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @HUGINN_RC_MAJOR@,@HUGINN_RC_MINOR@,0,0
PRODUCTVERSION  @HUGINN_RC_MAJOR@,@HUGINN_RC_MINOR@,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Ravenor907"
            VALUE "FileDescription",  "Huginn messenger"
            VALUE "FileVersion",      "@HUGINN_VERSION@"
            VALUE "InternalName",     "Huginn"
            VALUE "LegalCopyright",   "Ravenor907. Free software under the GNU GPL version 3."
            VALUE "OriginalFilename", "Huginn.exe"
            VALUE "ProductName",      "Huginn"
            VALUE "ProductVersion",   "@HUGINN_VERSION@"
            VALUE "Comments",         "https://github.com/Ravenor907/Huginn-Muninn"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
