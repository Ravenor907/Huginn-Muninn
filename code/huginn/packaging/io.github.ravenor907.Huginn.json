{
    "id": "io.github.ravenor907.Huginn",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.10",
    "sdk": "org.kde.Sdk",
    "command": "huginn",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=all",
        "--filesystem=xdg-download",
        "--filesystem=xdg-documents",
        "--filesystem=xdg-pictures",
        "--filesystem=xdg-videos:ro",
        "--filesystem=xdg-music:ro",
        "--system-talk-name=org.freedesktop.NetworkManager",
        "--talk-name=org.freedesktop.Flatpak",
        "--talk-name=org.freedesktop.ScreenSaver",
        "--talk-name=org.freedesktop.Notifications",
        "--socket=pulseaudio",
        "--system-talk-name=org.bluez",
        "--system-talk-name=org.freedesktop.UPower",
        "--env=BLUETOOTH_FORCE_DBUS_LE_VERSION=5.64.0"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig",
        "/share/doc",
        "/share/man",
        "*.a",
        "*.la"
    ],
    "modules": [
        {
            "name": "huginn",
            "buildsystem": "cmake-ninja",
            "subdir": "huginn",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DHUGINN_VERSION=0.1"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../.."
                },
                {
                    "type": "archive",
                    "url": "https://freedesktop.org/software/pulseaudio/webrtc-audio-processing/webrtc-audio-processing-1.3.tar.xz",
                    "sha256": "2365e93e778d7b61b5d6e02d21c47d97222e9c7deff9e1d0838ad6ec2e86f1b9",
                    "dest": "huginn/third_party/webrtc-audio-processing-1.3"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/abseil/abseil-cpp/archive/20230125.1.tar.gz",
                    "sha256": "81311c17599b3712069ded20cca09a62ab0bf2a89dfa16993786c8782b7ed145",
                    "dest": "huginn/third_party/abseil-cpp-20230125.1"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/xiph/rnnoise/releases/download/v0.2/rnnoise-0.2.tar.gz",
                    "sha256": "90fce4b00b9ff24c08dbfe31b82ffd43bae383d85c5535676d28b0a2b11c0d37",
                    "dest": "huginn/third_party/rnnoise-0.2"
                }
            ],
            "make-args": [
                "-k",
                "0"
            ]
        }
    ]
}
